# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=dental_clinic_db
DB_PORT=3306

# Server
PORT=8080
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
CORS_ORIGIN=http://localhost:5173
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret_here

# VNPay sandbox
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/vnpay-return
VNPAY_IPN_URL=http://localhost:8080/api/invoices/vnpay-ipn
VNPAY_ORDER_TYPE=billpayment

# Email reminders
SMTP_HOST=smtp.gmail.com
SMTP_SERVERNAME=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Phenikaa Dental <your_email@gmail.com>"
EMAIL_REMINDER_ENABLED=false
SLOT_RELEASE_NOTIFY_WINDOW_DAYS=14
SLOT_RELEASE_NOTIFY_LIMIT=8

# Zalo OA reminders
# Cần Zalo Official Account access token và zaloUserId của khách đã quan tâm OA.
ZALO_REMINDER_ENABLED=false
ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token
ZALO_MESSAGE_URL=https://openapi.zalo.me/v3.0/oa/message/cs
ZALO_TIMEOUT_MS=10000

# AI chatbox
# Bật true khi muốn dùng AI API. Nếu tắt hoặc thiếu key, hệ thống tự dùng trợ lý nội bộ.
AI_CHAT_ENABLED=false
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=12000
AI_KNOWLEDGE_MIN_SCORE=0.48

# Chat AI safety and conversation state
CHAT_MAX_MESSAGE_LENGTH=1200
CHAT_RATE_LIMIT_WINDOW_MS=10000
CHAT_RATE_LIMIT_MAX=8
CHAT_DEDUPE_TTL_MS=300000
CHAT_ASSISTANT_STATE_TTL_MINUTES=30
